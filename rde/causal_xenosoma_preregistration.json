{
  "schema": 1,
  "protocol": "rde-causal-xenosoma-v1",
  "surface": {
    "observation": "stable",
    "bytes": 32
  },
  "toggle": {
    "feature": "counterfactual-toggle",
    "states": ["alpha", "beta"]
  },
  "families": {
    "trial": {"name": "rde-owned-trial-v1", "count": 6},
    "holdout": {"name": "rde-owned-unseen-holdout-v1", "count": 4}
  },
  "baselines": ["surface-only-read", "surface-only-rephrase", "surface-only-aggregate", "surface-only-random-guess"],
  "thresholds": {
    "minimumInformationGainBits": 0.9,
    "maximumBaselineInformationGainBits": 0.0,
    "minimumTrialAccuracy": 1.0,
    "minimumHoldoutAccuracy": 1.0,
    "minimumClassDiversity": 2
  },
  "falsifiers": [
    "surface-baseline-information-gain",
    "trial-class-collapse",
    "holdout-class-collapse",
    "holdout-overfit",
    "intervention-accuracy-below-threshold",
    "artifact-toggle-invalid",
    "hidden-label-leakage"
  ],
  "killCondition": "Fail closed on any baseline gain, class collapse, holdout error, hidden-label exposure, or artifact mutation."
}

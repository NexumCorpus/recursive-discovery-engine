# Copy to .env and fill in. The engine reads OPENROUTER_API_KEY from the environment.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the per-role models (defaults live in rde/config.py).
# Keep three DISTINCT vendors to preserve the anti-blind-spot property.
# RDE_BUILDER_MODEL=openai/gpt-5.1-codex
# RDE_ADVERSARY_MODEL=google/gemini-3.1-pro-preview
# RDE_SYNTHESIZER_MODEL=anthropic/claude-opus-4.8
